DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ─── 生图服务（可选，OpenAI 兼容协议） ───
# 不配置 IMAGE_API_KEY 时游戏照常可玩（使用占位背景/立绘）。
# 填入任一家 OpenAI 兼容生图服务的 key 即可启用“开局预生成背景+立绘”。
#
# 硅基流动（FLUX.1-schnell 免费）：
#   IMAGE_API_KEY=sk-xxx
#   IMAGE_BASE_URL=https://api.siliconflow.cn/v1
#   IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# 智谱 CogView（cogview-3-flash 有免费额度）：
#   IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   IMAGE_MODEL=cogview-3-flash
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# 图片尺寸（需所选模型支持）：背景横屏 / 立绘竖屏
IMAGE_SIZE_BG=1344x768
IMAGE_SIZE_CHAR=768x1344
# 可选：画质 hd（精细慢）/ standard（快速），留空用模型默认
IMAGE_QUALITY=
# 可选：是否加水印 true/false，留空用服务商默认（智谱关水印需先在后台签免责声明）
IMAGE_WATERMARK=
