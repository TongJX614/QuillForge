DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ─── 生图服务（可选，OpenAI 兼容协议） ───
# 不配置 IMAGE_API_KEY 时游戏照常可玩（使用占位背景/立绘）。
# 填入任一家 OpenAI 兼容生图服务的 key 即可启用“开局预生成背景+立绘”。
#
# tokendance.space（Seedream 5.0 lite，推荐）：
#   IMAGE_API_KEY=sk-xxx
#   IMAGE_BASE_URL=https://tokendance.space/gateway/ark/v3
#   IMAGE_MODEL=seedream-5.0-lite
# 智谱 CogView（cogview-4 有免费额度）：
#   IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   IMAGE_MODEL=cogview-4
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=seedream-5.0-lite
# 图片尺寸（Seedream 系列要求总像素∈[2560x1440, 4096x4096]）
IMAGE_SIZE_BG=2560x1440
IMAGE_SIZE_CHAR=1440x2560
# 可选：画质 hd（精细慢）/ standard（快速），留空用模型默认
IMAGE_QUALITY=
# 可选：是否加水印 true/false，留空用服务商默认
IMAGE_WATERMARK=
# 可选：生图并发数（默认 6，推荐 9，超过 12 易触发限流）
#IMAGE_CONCURRENCY=9
# 可选：开局优先预加载的场景数（默认 2，这些场景的背景+出场角色立绘先生成，剩余素材后台补）
#IMAGE_BG_PRELOAD_COUNT=2

# ─── TTS 语音合成服务（MiMo TTS via tokendance.space）───
# 不配置 TTS_API_KEY 时游戏照常可玩（纯文字模式，无语音读出）。
# 使用 tokendance.space 网关代理的小米 MiMo-V2.5-TTS 系列模型。
#
# 两种模式：
#   1. 音色克隆（mimo-v2.5-tts-voiceclone）：角色有参考音频时自动启用，
#      将参考音频放在 quillforge/voice_samples/ 目录下，
#      在角色卡中设置 voiceSample 字段指向文件名（如 "character1.mp3"）。
#   2. 预置音色（mimo-v2.5-tts）：无参考音频时自动回退，
#      按 gender 自动选择预置男声(苏打)/女声(冰糖)。
#
# MiMo 预置音色列表：mimo_default/冰糖/茉莉/苏打/白桦/Mia/Chloe/Milo/Dean
# 中文女声: 冰糖、茉莉    中文男声: 苏打、白桦
# 英文女声: Mia、Chloe    英文男声: Milo、Dean
TTS_API_KEY=
TTS_BASE_URL=https://tokendance.space/gateway/mimo/v1
# 主模型：音色克隆（需角色有参考音频样本，否则自动回退到预置音色）
TTS_MODEL=mimo-v2.5-tts-voiceclone
# 回退模型：预置音色（无需参考音频）
TTS_FALLBACK_MODEL=mimo-v2.5-tts
# 默认预置音色
TTS_DEFAULT_VOICE=mimo_default
# 默认男声/女声预置音色（角色卡有 gender 字段时自动选择）
TTS_DEFAULT_VOICE_MALE=苏打
TTS_DEFAULT_VOICE_FEMALE=冰糖
# 按年龄分段的预置音色（顺序: 少年/青年/中年/老年）
# 男声: Milo(少年) 苏打(青年) Dean(中年) 白桦(老年)
TTS_VOICE_MALE_BY_AGE=Milo,苏打,Dean,白桦
# 女声: 茉莉(少年) 冰糖(青年) Mia(中年) Chloe(老年)
TTS_VOICE_FEMALE_BY_AGE=茉莉,冰糖,Mia,Chloe
# 年龄分段阈值: <=18 少年 / 19-35 青年 / 36-55 中年 / 56+ 老年
# TTS_AGE_THRESHOLDS=18,35,55
# 可选：角色名->音色ID/音频文件路径映射，逗号分隔，如 角色A:冰糖,角色B:voice_b.mp3
TTS_VOICE_MAP=
